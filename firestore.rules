rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'title', 'category', 'location', 'maxParticipants', 'price',
          'imageUrl', 'imagePath', 'ownerId', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'category', 'location', 'maxParticipants', 'price',
          'imageUrl', 'imagePath', 'ownerId', 'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.category in [
          'Sport', 'Culture', 'Cuisine', 'Nature', 'Bien-être', 'Autre'
        ]
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.maxParticipants is int
        && request.resource.data.maxParticipants > 0
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.imagePath is string
        && request.resource.data.imagePath.matches(
          '^activities/' + request.auth.uid + '/' + activityId + '\\.(jpg|png|webp)$'
        )
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'birthday', 'address', 'postalCode', 'city'
        ])
        && request.resource.data.keys().hasOnly([
          'birthday', 'address', 'postalCode', 'city'
        ])
        && request.resource.data.birthday is string
        && request.resource.data.address is string
        && request.resource.data.postalCode is string
        && request.resource.data.postalCode.matches('^[0-9]*$')
        && request.resource.data.city is string;
      allow list, delete: if false;
    }

    match /users/{userId}/cart/{activityId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['activityId', 'addedAt'])
        && request.resource.data.keys().hasOnly(['activityId', 'addedAt'])
        && request.resource.data.activityId == activityId
        && request.resource.data.addedAt == request.time
        && exists(/databases/$(database)/documents/activities/$(activityId));
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
